# Auto detect text files and perform LF normalization
* text=auto
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
Art/**/*.blend filter=lfs diff=lfs merge=lfs -text
Art/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Art/**/*.glb filter=lfs diff=lfs merge=lfs -text
Art/**/*.obj filter=lfs diff=lfs merge=lfs -text
Art/**/*.png filter=lfs diff=lfs merge=lfs -text
Art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Art/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Art/**/*.tga filter=lfs diff=lfs merge=lfs -text
Art/**/*.exr filter=lfs diff=lfs merge=lfs -text
Art/**/*.zip filter=lfs diff=lfs merge=lfs -text
Art/**/*.wav filter=lfs diff=lfs merge=lfs -text
Art/**/*.ogg filter=lfs diff=lfs merge=lfs -text
Art/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf
